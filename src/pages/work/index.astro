---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WorkCard from '../../components/ui/WorkCard.astro'
import FadeIn from '../../components/ui/FadeIn.astro'
import { content } from '../../data/content'
import { explorations } from '../../data/projects'
import type { Project } from '../../data/projects'

const projects = content.projects

// Filter chips. Each project carries tags (category + status) that the chips match on.
const tagsFor = (p: Project) => [p.category ?? 'product', p.status].join(' ')
const filters = [
  { id: 'all', label: 'All', match: (_p: Project) => true },
  { id: 'live', label: 'Live', match: (p: Project) => p.status === 'live' },
  { id: 'product', label: 'AI & SaaS products', match: (p: Project) => p.category === 'product' },
  { id: 'tool', label: 'Free tools', match: (p: Project) => p.category === 'tool' },
  { id: 'client', label: 'Client & corporate', match: (p: Project) => p.category === 'client' || p.category === 'corporate' },
  { id: 'beta', label: 'In beta', match: (p: Project) => p.status === 'beta' || p.status === 'building' || p.status === 'upcoming' },
]
  .map((f) => ({ ...f, count: projects.filter(f.match).length }))
  .filter((f) => f.count > 0)

const liveCount = projects.filter((p) => p.status === 'live' && (p.category === 'product' || p.category === 'tool')).length
---

<BaseLayout title="Work" description="Live AI products, free tools, client sites and corporate work built by Akash Yadav.">
  <!-- Page head -->
  <section class="pt-16 md:pt-24 pb-12">
    <div class="eyebrow eyebrow-rule mb-6">Selected work · {projects.length} projects</div>
    <h1 class="t-display m-0 mb-5">Projects I&apos;ve worked on.</h1>
    <p class="t-lead max-w-[58ch] m-0">
      AI products and free tools I build and run myself, a client site, and the platform from my day job.
      Most are live, so you can try them. Click any project to read more about it.
    </p>

    <!-- Trust strip: numbers lead, labels stay quiet -->
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-12 pt-8 divider m-0">
      <div class="flex flex-col gap-1.5">
        <dt class="t-meta">building for the web</dt>
        <dd class="order-first m-0 font-display text-[28px] leading-none font-semibold text-fg">4+ years</dd>
      </div>
      <div class="flex flex-col gap-1.5">
        <dt class="t-meta">Lighthouse score on big inventory pages</dt>
        <dd class="order-first m-0 font-display text-[28px] leading-none font-semibold text-fg">45 → 80+</dd>
      </div>
      <div class="flex flex-col gap-1.5">
        <dt class="t-meta">live products you can try today</dt>
        <dd class="order-first m-0 font-display text-[28px] leading-none font-semibold text-fg">{liveCount}</dd>
      </div>
    </dl>
  </section>

  <!-- Filter: a recessed tray; the selected option is raised -->
  <section class="pb-8" aria-label="Filter projects">
    <div class="filter-tray" role="group" aria-label="Show projects by type">
      {filters.map((f, i) => (
        <button type="button" class="filter-chip" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}
          <span class="filter-count">{f.count}</span>
        </button>
      ))}
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
  </section>

  <!-- Work grid -->
  <section class="pb-16 md:pb-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <div class="h-full" data-filter-item data-tags={tagsFor(project)}>
          <FadeIn delay={Math.min(i, 6) * 0.06} class="h-full">
            <WorkCard project={project} index={i} />
          </FadeIn>
        </div>
      ))}
    </div>
  </section>

  {explorations.length > 0 && (
    <section class="pb-16 md:pb-24" aria-labelledby="explorations-heading">
      <div class="panel p-6 md:p-10">
        <div class="max-w-3xl mb-8">
          <div class="eyebrow eyebrow-rule mb-4">Explorations</div>
          <h2 id="explorations-heading" class="t-h2 m-0 mb-3">Things I explored along the way.</h2>
          <p class="t-body m-0">
            Early products and experiments I built and then paused. Some are still online, so feel free to try them.
          </p>
        </div>
        <ul class="list-none p-0 m-0 grid grid-cols-1 md:grid-cols-2 gap-x-10">
          {explorations.map((p) => {
            const live = p.links.find((l) => /^https?:/.test(l.href))
            return (
              <li class="flex flex-col gap-1.5 py-5 divider">
                <div class="flex items-baseline gap-3">
                  <h3 class="t-h3 text-[18px] m-0">{p.name}</h3>
                  <span class="t-meta ml-auto whitespace-nowrap">{p.year.replace(/\s+to now$/, '')}</span>
                </div>
                <p class="t-body text-[14.5px] m-0">{p.tagline || p.summary}</p>
                <div class="flex flex-wrap gap-x-5 text-[14px]">
                  <a href={`/work/${p.slug}`} class="link inline-flex items-center min-h-[32px]">
                    Read more<span class="sr-only"> about {p.name}</span>
                  </a>
                  {live && p.status !== 'sunset' && (
                    <a href={live.href} target="_blank" rel="noopener noreferrer" class="link inline-flex items-center min-h-[32px]">
                      Try it ↗<span class="sr-only"> (opens {p.name} in a new tab)</span>
                    </a>
                  )}
                </div>
              </li>
            )
          })}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .filter-tray {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 9999px;
    background: var(--bg-sunken);
  }
  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 16px;
    border-radius: 9999px;
    font-size: 14px;
    color: var(--fg-muted);
    transition: background-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }
  .filter-chip:hover {
    color: var(--fg);
  }
  .filter-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-subtle);
  }
  .filter-chip[aria-pressed='true'] {
    background: var(--bg-elev);
    color: var(--fg);
    font-weight: 500;
    box-shadow: var(--shadow-sm);
  }
  .filter-chip[aria-pressed='true'] .filter-count {
    color: var(--accent);
  }
  .filter-chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 640px) {
    .filter-tray {
      border-radius: 20px;
    }
  }
</style>

<script>
  function initWorkFilter() {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-item]'))
    const status = document.querySelector<HTMLElement>('[data-filter-status]')
    if (!chips.length) return

    const matches = (tags: string, id: string) => {
      const t = tags.split(' ')
      if (id === 'all') return true
      if (id === 'client') return t.includes('client') || t.includes('corporate')
      if (id === 'beta') return t.includes('beta') || t.includes('building') || t.includes('upcoming')
      return t.includes(id)
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.filter ?? 'all'
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)))
        let shown = 0
        items.forEach((item) => {
          const on = matches(item.dataset.tags ?? '', id)
          item.hidden = !on
          if (on) shown++
        })
        if (status) status.textContent = `Showing ${shown} project${shown === 1 ? '' : 's'}`
      })
    })
  }
  initWorkFilter()
</script>
