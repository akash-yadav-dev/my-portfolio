---
import BaseLayout from '../../layouts/BaseLayout.astro'
import WritingCard from '../../components/ui/WritingCard.astro'
import FadeIn from '../../components/ui/FadeIn.astro'
import { content } from '../../data/content'
---

<BaseLayout
  title="Writing"
  description="Articles by Akash Yadav about building websites, web apps, and the tools behind them."
>
  <!-- Page head -->
  <section class="pt-16 md:pt-24 pb-12">
    <div class="eyebrow eyebrow-rule mb-6">Writing · {content.writing.length} posts</div>
    <h1 class="t-display m-0 mb-5">Things I write about.</h1>
    <p class="t-lead max-w-[58ch] m-0">
      Notes and articles on building software, the tools I use, and the occasional other topic. New posts whenever
      I have something worth sharing.
    </p>
  </section>

  <!-- Grid -->
  <section class="pb-16 md:pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {content.writing.map((article, i) => (
        <FadeIn delay={Math.min(i, 6) * 0.06} class="h-full">
          <WritingCard article={article} />
        </FadeIn>
      ))}
    </div>
  </section>
</BaseLayout>
