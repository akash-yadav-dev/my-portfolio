---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { content } from '../../data/content'

export function getStaticPaths() {
  const reserved = 'logic-first-ai'
  const slugs = content.writing.filter((a) => a.slug !== reserved).map((a) => a.slug)
  return slugs.map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params
const article = content.writing.find((a) => a.slug === slug)
---

<BaseLayout title={article?.title ?? 'Writing'} description={article?.excerpt ?? ''}>
  <article class="pt-12 md:pt-16 pb-20 md:pb-28 max-w-[72ch]">
    <a href="/writing" class="back-link mb-10">
      <span aria-hidden="true">←</span> All writing
    </a>

    <div class="flex flex-wrap items-center gap-3 t-meta mb-5">
      <span>{article?.date}</span>
      <span aria-hidden="true">·</span>
      <span>{article?.readTime} read</span>
    </div>

    <h1 class="t-h1 m-0 mb-6">{article?.title}</h1>
    <p class="t-lead m-0 mb-10">{article?.excerpt}</p>

    <div class="panel p-8 md:p-10 text-center">
      <p class="eyebrow mb-3">Full article</p>
      <p class="t-body max-w-[50ch] mx-auto m-0">
        The full version of this article lives elsewhere. When it&apos;s published, it will be linked from here.
      </p>
    </div>
  </article>
</BaseLayout>
