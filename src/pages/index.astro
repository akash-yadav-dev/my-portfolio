---
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/sections/Hero.astro'
import ContactBlock from '../components/sections/ContactBlock.astro'
import SectionHeader from '../components/ui/SectionHeader.astro'
import WorkCard from '../components/ui/WorkCard.astro'
import WritingCard from '../components/ui/WritingCard.astro'
import FadeIn from '../components/ui/FadeIn.astro'
import { content } from '../data/content'

const featured = content.projects.slice(0, 3)
const recentWriting = content.writing.slice(0, 3)
const { process, services } = content

const stack = [
  { group: 'Frontend', items: ['React', 'Next.js', 'TypeScript', 'Redux', 'Tailwind CSS'] },
  { group: 'Backend & data', items: ['Node.js', 'NestJS', 'Java', 'Spring Boot', 'PostgreSQL', 'MongoDB'] },
  { group: 'AI & delivery', items: ['OpenAI API', 'RAG', 'MCP servers', 'Docker', 'GitHub Actions', 'Vercel'] },
]
---

<BaseLayout
  title={`${content.profile.name} — ${content.profile.role}`}
  description="Akash Yadav, freelance full stack developer. I build websites and web apps, including booking and ordering platforms, with seven live products you can try. Based in Bangalore, open to remote freelance work."
>
  <Hero />

  <!-- Featured Work -->
  <section class="section">
    <FadeIn>
      <SectionHeader num="01" label="Selected Work" title="A few projects I've worked on." />
    </FadeIn>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((project, i) => (
        <FadeIn delay={i * 0.06} class="h-full">
          <WorkCard project={project} index={i} />
        </FadeIn>
      ))}
    </div>
    <FadeIn delay={0.15}>
      <div class="mt-10 flex justify-center">
        <a href="/work" class="btn btn-secondary">
          See all projects
          <span class="btn-arrow text-fg-subtle" aria-hidden="true">→</span>
        </a>
      </div>
    </FadeIn>
  </section>

  <!-- Services -->
  <section class="section">
    <FadeIn>
      <SectionHeader num="02" label={services.title} title="How I can help you." />
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {services.items.map((service, i) => (
        <FadeIn delay={i * 0.06} class="h-full">
          <article class="card h-full p-6 md:p-8">
            <h3 class="t-h3 mb-3">{service.title}</h3>
            <p class="t-body m-0">{service.body}</p>
          </article>
        </FadeIn>
      ))}
    </div>
  </section>

  <!-- Process: a recessed band so it reads as one group of steps -->
  <section class="section">
    <FadeIn>
      <SectionHeader num="03" label={process.title} title="From idea to launch." />
    </FadeIn>
    <ol class="panel list-none m-0 p-2 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-2">
      {process.steps.map((step, i) => (
        <li class="p-6 rounded-xl">
          <p class="t-meta text-accent mb-4">Step 0{i + 1}</p>
          <h3 class="t-h3 mb-2">{step.title}</h3>
          <p class="t-body m-0">{step.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Stack -->
  <section class="section">
    <FadeIn>
      <SectionHeader num="04" label="Stack" title="What I use to build." />
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {stack.map((col) => (
        <div class="card p-6">
          <h3 class="eyebrow mb-4">{col.group}</h3>
          <ul class="list-none m-0 p-0 flex flex-wrap gap-2">
            {col.items.map((tech) => <li class="chip">{tech}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Writing -->
  <section class="section">
    <FadeIn>
      <SectionHeader num="05" label="Latest Writing" title="Things I write about." />
    </FadeIn>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {recentWriting.map((article, i) => (
        <FadeIn delay={i * 0.08} class="h-full">
          <WritingCard article={article} />
        </FadeIn>
      ))}
    </div>
    <FadeIn delay={0.3}>
      <div class="mt-10 flex justify-center">
        <a href="/writing" class="btn btn-secondary">
          See all writing
          <span class="btn-arrow text-fg-subtle" aria-hidden="true">→</span>
        </a>
      </div>
    </FadeIn>
  </section>

  <!-- Contact CTA -->
  <section class="section pt-0 md:pt-0">
    <FadeIn>
      <ContactBlock />
    </FadeIn>
  </section>
</BaseLayout>
