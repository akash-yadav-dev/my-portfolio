---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404" description="Page not found" noindex>
  <section class="pt-16 md:pt-24 pb-20 md:pb-28">
    <div class="eyebrow eyebrow-rule mb-6">Error 404</div>
    <h1 class="t-display m-0 mb-5">No such page.</h1>
    <p class="t-lead max-w-[50ch] m-0 mb-10">
      The page you&apos;re looking for doesn&apos;t exist or has been moved.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">
        <span class="btn-arrow" aria-hidden="true">←</span>
        Back home
      </a>
      <a href="/work" class="btn btn-secondary">
        See my work
        <span class="btn-arrow text-fg-subtle" aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
