---
import { parseRichText } from '../../lib/utils'
import { content } from '../../data/content'

const { contact, profile } = content
const headlineParts = parseRichText(contact.headline)
---

<div
  class="px-8 md:px-14 py-14 md:py-16 rounded-[22px] overflow-hidden"
  style="background: var(--bg-inverse); color: var(--fg-on-dark)"
>
  <h2
    class="font-display font-semibold mb-5"
    style="font-size: clamp(30px,4.5vw,52px); line-height: 1.05; letter-spacing: -0.02em; white-space: pre-line"
  >
    {
      headlineParts.map((part) =>
        part.type === 'accent' ? (
          <em class="not-italic" style="color: var(--accent-on-dark)">{part.content}</em>
        ) : (
          <span>{part.content}</span>
        ),
      )
    }
  </h2>

  <p class="mb-8 leading-[1.6] max-w-[50ch]" style="font-size: clamp(16px,1.5vw,19px); color: var(--fg-on-dark-muted)">
    {contact.body}
  </p>

  <a href={`mailto:${profile.email}`} class="btn btn-primary">
    {profile.email}
    <span class="btn-arrow" aria-hidden="true">→</span>
  </a>

  <dl class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 pt-8" style="border-top: 1px solid rgb(250 250 249 / 0.12)">
    {contact.channels.map((ch) => (
      <div>
        <dt class="font-mono text-[12px] uppercase tracking-[0.1em] mb-2" style="color: var(--fg-on-dark-muted)">
          {ch.label}
        </dt>
        <dd class="m-0 text-[15px]">
          <a
            href={ch.href}
            class="underline underline-offset-4 decoration-1 transition-opacity hover:opacity-80"
            style="color: var(--accent-on-dark)"
          >
            {ch.value}
          </a>
        </dd>
      </div>
    ))}
  </dl>
</div>
