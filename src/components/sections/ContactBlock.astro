---
import { parseRichText } from '../../lib/utils'
import { content } from '../../data/content'

const { contact, profile } = content
const headlineParts = parseRichText(contact.headline)
---

<div class="px-8 md:px-14 py-14 md:py-16 rounded-xl overflow-hidden" style="background: var(--fg); color: var(--bg)">
  <h2
    class="font-display font-semibold mb-6"
    style="font-size: clamp(30px,4.5vw,52px); line-height: 1.05; letter-spacing: -0.02em; white-space: pre-line"
  >
    {
      headlineParts.map((part) =>
        part.type === 'accent' ? (
          <em class="not-italic text-accent">{part.content}</em>
        ) : (
          <span>{part.content}</span>
        ),
      )
    }
  </h2>

  <p class="mb-6 leading-[1.4] max-w-[50ch]" style="font-size: clamp(16px,1.5vw,19px); opacity: 0.65">
    {contact.body}
  </p>

  <a
    href={`mailto:${profile.email}`}
    class="lift-on-hover btn-accent-primary inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-sm font-medium transition-all duration-200 group"
    style="background: var(--accent); color: var(--accent-fg)"
  >
    {profile.email}
    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </a>

  <dl class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-10 pt-8 font-mono text-[11px]" style="border-top: 1px solid rgba(128,128,128,0.2)">
    {contact.channels.map((ch) => (
      <div>
        <dt class="uppercase tracking-[0.12em] mb-1.5" style="opacity: 0.45; font-size: 10px">
          {ch.label}
        </dt>
        <dd class="m-0">
          <a href={ch.href} class="text-accent border-b border-current hover:opacity-80 transition-opacity">
            {ch.value}
          </a>
        </dd>
      </div>
    ))}
  </dl>
</div>
