---
import { parseRichText } from '../../lib/utils'
import { content } from '../../data/content'

const { profile, stats } = content
const taglineParts = parseRichText(profile.tagline)
---

<section class="py-16 md:py-20">
  <!-- Meta bar -->
  <div class="hero-reveal flex gap-5 flex-wrap font-mono text-[11px] text-fg-muted mb-8">
    <span class="flex items-center gap-2">
      <span class="pulse-dot"></span>
      {profile.available}
    </span>
    <span>{profile.location}</span>
  </div>

  <div
    class:list={[
      profile.showPhoto
        ? 'grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-10 lg:gap-14 items-center'
        : 'max-w-3xl',
    ]}
  >
    <div>
      <!-- Heading -->
      <h1
        class="hero-reveal font-display font-semibold mb-6"
        style="font-size: clamp(38px,6vw,60px); letter-spacing: -0.02em; line-height: 1.04; white-space: pre-line"
      >
        {
          taglineParts.map((part) =>
            part.type === 'accent' ? (
              <em class="italic font-light text-accent">{part.content}</em>
            ) : (
              <span>{part.content}</span>
            ),
          )
        }
      </h1>

      <!-- Sub -->
      <p
        class="hero-reveal text-fg-muted mb-8 leading-[1.6]"
        style="font-size: clamp(16px,1.4vw,19px); max-width: 52ch"
      >
        {profile.intro}
      </p>

      <!-- CTAs -->
      <div class="hero-reveal flex gap-3 flex-wrap items-center">
        <a
          href="/contact"
          class="lift-on-hover btn-accent-primary inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-sm font-medium transition-all duration-200 group"
          style="background: var(--accent); color: var(--accent-fg)"
        >
          Start a project
          <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
        </a>
        <a
          href="/work"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-sm font-medium border border-line-strong transition-all duration-200 hover:border-fg hover:bg-bg-sunken group"
        >
          See selected work
          <span class="transition-transform duration-200 group-hover:translate-x-1 opacity-50">→</span>
        </a>
      </div>
    </div>

    {profile.showPhoto && (
      <div class="hero-reveal">
        <div class="relative w-full max-w-[280px] mx-auto rounded-2xl overflow-hidden border border-line bg-bg-sunken shadow-md">
          <img
            src={profile.photo}
            alt={`${profile.name} headshot`}
            width="640"
            height="760"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    )}
  </div>

  <!-- Stats -->
  <dl class="hero-reveal grid grid-cols-2 md:grid-cols-4 gap-x-10 gap-y-8 mt-16 pt-8 border-t border-line">
    {stats.map((stat) => (
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.12em] text-fg-subtle mb-2">
          {stat.label}
        </dt>
        <dd class="font-display text-3xl font-semibold tracking-snug m-0">
          {stat.value}
          {stat.suffix && (
            <small class="font-mono text-[11px] text-fg-muted font-normal ml-1.5">
              {stat.suffix}
            </small>
          )}
        </dd>
      </div>
    ))}
  </dl>
</section>
