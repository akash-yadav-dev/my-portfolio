---
import { parseRichText } from '../../lib/utils'
import { content } from '../../data/content'

const { profile, stats } = content
const taglineParts = parseRichText(profile.tagline)
---

<section class="pt-16 pb-16 md:pt-24 md:pb-20">
  <!-- Meta bar -->
  <div class="hero-reveal flex gap-x-6 gap-y-2 flex-wrap t-meta mb-8">
    <span class="flex items-center gap-2 text-fg-muted">
      <span class="pulse-dot"></span>
      {profile.available}
    </span>
    <span>{profile.location}</span>
  </div>

  <div
    class:list={[
      profile.showPhoto
        ? 'grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-10 lg:gap-14 items-center'
        : 'max-w-3xl',
    ]}
  >
    <div>
      <h1 class="hero-reveal t-display mb-6" style="white-space: pre-line">
        {
          taglineParts.map((part) =>
            part.type === 'accent' ? (
              <em class="italic font-light text-accent">{part.content}</em>
            ) : (
              <span>{part.content}</span>
            ),
          )
        }
      </h1>

      <p class="hero-reveal t-lead mb-10 max-w-[54ch]">
        {profile.intro}
      </p>

      <div class="hero-reveal flex gap-3 flex-wrap items-center">
        <a href="/contact" class="btn btn-primary">
          Start a project
          <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a href="/work" class="btn btn-secondary">
          See selected work
          <span class="btn-arrow text-fg-subtle" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    {profile.showPhoto && (
      <div class="hero-reveal">
        <div class="card relative w-full max-w-[280px] mx-auto overflow-hidden">
          <img
            src={profile.photo}
            alt={`${profile.name} headshot`}
            width="640"
            height="760"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    )}
  </div>

  <!-- Stats: the numbers carry the weight, labels stay quiet -->
  <dl class="hero-reveal grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-8 mt-16 md:mt-20 pt-8 divider">
    {stats.map((stat) => (
      <div class="flex flex-col gap-2">
        <dt class="t-meta">{stat.label}</dt>
        <dd class="order-first font-display text-[34px] leading-none font-semibold tracking-snug text-fg m-0">
          {stat.value}{stat.suffix && <span class="text-fg-subtle font-normal">{stat.suffix}</span>}
        </dd>
      </div>
    ))}
  </dl>
</section>
