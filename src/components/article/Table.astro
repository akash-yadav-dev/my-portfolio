---
interface Props {
  headers: string[]
  rows: string[][]
}

const { headers, rows } = Astro.props
---

<div class="card overflow-x-auto my-8" tabindex="0" role="region" aria-label="Table">
  <table class="w-full text-[14.5px] border-collapse">
    <thead>
      <tr style="background: var(--bg-sunken)">
        {headers.map((h) => (
          <th scope="col" class="text-left px-5 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-fg-subtle font-medium whitespace-nowrap">
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="divider">
          {row.map((cell, j) => (
            <td class:list={['px-5 py-3 leading-snug', j === 0 ? 'text-fg font-medium' : 'text-fg-muted']}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
