---
interface Props {
  id: string
  n: string
  label: string
}

const { id, n, label } = Astro.props
---

<div id={id} class="flex items-center gap-3 font-mono text-[11px] text-fg-subtle uppercase tracking-wider mt-20 mb-5">
  <span class="w-6 h-px" style="background: var(--accent)"></span>
  <span class="text-accent">{n}</span>
  <span>{label}</span>
</div>
