---
interface Props {
  n: string
  title: string
}

const { n, title } = Astro.props
---

<div class="card my-8 overflow-hidden">
  <div class="px-6 py-4 flex items-baseline gap-4 divider-b">
    <span class="t-meta text-accent">{n}</span>
    <h3 class="t-h3 text-[19px] m-0">{title}</h3>
  </div>
  <div class="px-6 py-5 space-y-4">
    <slot />
  </div>
</div>
