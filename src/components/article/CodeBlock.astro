---
interface Props {
  code: string
}

const { code } = Astro.props
---

<div class="my-8 rounded-2xl overflow-hidden" style="background: var(--bg-inverse)">
  <div class="px-4 py-3 flex gap-1.5" aria-hidden="true">
    <span class="w-2.5 h-2.5 rounded-full" style="background: rgb(250 250 249 / 0.18)"></span>
    <span class="w-2.5 h-2.5 rounded-full" style="background: rgb(250 250 249 / 0.18)"></span>
    <span class="w-2.5 h-2.5 rounded-full" style="background: rgb(250 250 249 / 0.18)"></span>
  </div>
  <pre class="m-0 px-5 pb-5 overflow-x-auto font-mono text-[13px] leading-relaxed" style="color: var(--fg-on-dark-muted)" tabindex="0">{code}</pre>
</div>
