---
import type { Project } from '../../data/projects'
import Badge from './Badge.astro'

interface Props {
  project: Project
  index: number
}

const { project, index } = Astro.props

const placeholderLabel: Partial<Record<Project['status'], string>> = {
  corporate: 'Corporate platform, internal product',
  upcoming: 'In active development',
  building: 'Interface live, more coming',
}

const idx = String(index + 1).padStart(2, '0')
---

<a
  href={`/work/${project.slug}`}
  class="lift-on-hover lift-lg group relative flex flex-col h-full rounded-xl overflow-hidden border border-line bg-bg transition-all duration-200 hover:border-line-strong hover:shadow-md cursor-pointer"
>
  <!-- Screenshot or themed placeholder. rounded-t-xl keeps the image clipped on hover. -->
  <div class="relative aspect-[16/10] overflow-hidden rounded-t-xl border-b border-line bg-bg-sunken [transform:translateZ(0)]">
    {project.category === 'client' && (
      <span class="absolute top-3 left-3 z-10 rounded-full shadow-sm">
        <Badge category="client" />
      </span>
    )}
    <span class="absolute top-3 right-3 z-10 rounded-full shadow-sm">
      <Badge status={project.status} />
    </span>
    {project.visual ? (
      <img
        src={project.visual.src}
        alt={project.visual.alt}
        width="1280"
        height="800"
        loading="lazy"
        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full grid place-items-center text-center px-4">
        <div>
          <span
            class="inline-grid place-items-center w-11 h-11 rounded-md font-display font-semibold text-base mb-3"
            style={project.status === 'corporate'
              ? 'background: var(--badge-corp-bg); color: var(--badge-corp-fg)'
              : 'background: var(--accent-soft); color: var(--accent)'}
          >
            {project.name.slice(0, 2)}
          </span>
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-fg-subtle leading-relaxed">
            {placeholderLabel[project.status] ?? 'No public preview'}
          </p>
        </div>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-baseline gap-x-3 mb-2">
      <span class="font-mono text-[12px] select-none" style="color: var(--accent-dim)">
        {idx}
      </span>
      <h3
        class="font-display font-semibold tracking-snug leading-tight transition-colors duration-150 group-hover:text-accent"
        style="font-size: clamp(19px,2.2vw,23px)"
      >
        {project.name}
      </h3>
      <span class="font-mono text-[11px] text-fg-subtle ml-auto whitespace-nowrap">{project.year}</span>
    </div>
    <p class="text-fg-muted text-[14.5px] leading-relaxed mb-4 line-clamp-3">
      {project.summary}
    </p>
    <div class="mt-auto flex gap-1.5 flex-wrap items-center">
      {project.stack.slice(0, 3).map((tech) => <Badge>{tech}</Badge>)}
    </div>
  </div>
</a>
