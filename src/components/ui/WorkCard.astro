---
import type { Project } from '../../data/projects'
import Badge from './Badge.astro'

interface Props {
  project: Project
  /** Position in the list (kept for callers; not displayed). */
  index?: number
}

const { project } = Astro.props

const placeholderLabel: Partial<Record<Project['status'], string>> = {
  corporate: 'Corporate platform, internal product',
  upcoming: 'In active development',
  building: 'Interface live, more coming',
}

---

<a
  href={`/work/${project.slug}`}
  class="card card-interactive group relative flex flex-col h-full overflow-hidden"
>
  <!-- Preview: recessed frame so the screenshot sits inside the card -->
  <div class="relative aspect-[16/10] overflow-hidden bg-bg-sunken [transform:translateZ(0)]">
    {project.category === 'client' && (
      <span class="absolute top-3 left-3 z-10 rounded-full shadow-sm">
        <Badge category="client" />
      </span>
    )}
    <span class="absolute top-3 right-3 z-10 rounded-full shadow-sm">
      <Badge status={project.status} />
    </span>
    {project.visual ? (
      <img
        src={project.visual.src}
        alt={project.visual.alt}
        width="1265"
        height="791"
        loading="lazy"
        class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="w-full h-full grid place-items-center text-center px-4">
        <div>
          <span
            class="inline-grid place-items-center w-12 h-12 rounded-xl font-display font-semibold text-base mb-3"
            style={project.status === 'corporate'
              ? 'background: var(--badge-corp-bg); color: var(--badge-corp-fg)'
              : 'background: var(--bg-elev); color: var(--fg-muted)'}
          >
            {project.name.slice(0, 2)}
          </span>
          <p class="t-meta uppercase tracking-[0.08em]">
            {placeholderLabel[project.status] ?? 'No public preview'}
          </p>
        </div>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex flex-col flex-1 p-6">
    <div class="flex items-baseline gap-x-3 mb-2">
      <h3 class="t-h3 transition-colors duration-150 group-hover:text-accent">
        {project.name}
      </h3>
      <span class="t-meta ml-auto whitespace-nowrap">{project.year}</span>
    </div>
    <p class="t-body text-[14.5px] mb-5 line-clamp-3">
      {project.summary}
    </p>
    <ul class="mt-auto list-none m-0 p-0 flex gap-1.5 flex-wrap items-center" aria-label="Built with">
      {project.stack.slice(0, 3).map((tech) => <li class="chip">{tech}</li>)}
    </ul>
  </div>
</a>
