---
interface Props {
  num: string
  label: string
  title: string
  desc?: string
}

const { num, label, title, desc } = Astro.props
const lines = title.split('\n')
---

<div class="section-head grid grid-cols-1 md:grid-cols-[200px_1fr] gap-3 md:gap-12 items-baseline">
  <div class="eyebrow">
    <span class="text-accent">{num}</span>
    <span aria-hidden="true">/</span>
    <span>{label}</span>
  </div>
  <div>
    <h2 class="t-h2 m-0">
      {
        lines.map((line, i) => (
          <span>
            {line}
            {i < lines.length - 1 && <br />}
          </span>
        ))
      }
    </h2>
    {desc && <p class="t-body mt-3 max-w-[56ch]">{desc}</p>}
  </div>
</div>
