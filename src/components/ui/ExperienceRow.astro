---
import type { Experience } from '../../data/content'

interface Props {
  exp: Experience
}

const { exp } = Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-[180px_1fr_160px] gap-2 md:gap-8 py-8 divider items-baseline">
  <span class="t-meta">{exp.when}</span>
  <div>
    <h3 class="t-h3 mb-2">{exp.role}</h3>
    <p class="t-body m-0">{exp.note}</p>
    {exp.highlights && exp.highlights.length > 0 && (
      <ul class="mt-5 flex flex-col gap-2.5 list-none p-0 m-0">
        {exp.highlights.map((h) => (
          <li class="t-body text-[14.5px] relative pl-5 before:content-[''] before:absolute before:left-0 before:top-[0.65em] before:w-1.5 before:h-1.5 before:rounded-full before:bg-line-strong">
            {h}
          </li>
        ))}
      </ul>
    )}
  </div>
  <span class="t-meta md:text-right">{exp.where}</span>
</div>
