---
import type { Article } from '../../data/content'

interface Props {
  article: Article
}

const { article } = Astro.props
---

<a
  href={`/writing/${article.slug}`}
  class="card card-interactive group flex flex-col h-full p-6"
>
  <div class="flex justify-between gap-4 t-meta mb-4">
    <span>{article.date}</span>
    <span>{article.readTime}</span>
  </div>
  <h3 class="t-h3 text-[19px] mb-3 transition-colors duration-150 group-hover:text-accent">
    {article.title}
  </h3>
  <p class="t-body text-[14.5px] m-0">{article.excerpt}</p>
</a>
