---
import type { Article } from '../../data/content'

interface Props {
  article: Article
}

const { article } = Astro.props
---

<a
  href={`/writing/${article.slug}`}
  class="lift-on-hover group block p-5 border border-line rounded-lg transition-all duration-200 hover:border-line-strong hover:shadow-md h-full"
  style="background: var(--bg)"
>
  <div class="flex justify-between font-mono text-[10px] text-fg-subtle uppercase tracking-[0.12em] mb-3">
    <span>{article.date}</span>
    <span>{article.readTime}</span>
  </div>
  <h4
    class="font-display text-lg font-semibold leading-snug mb-3 transition-colors duration-100 group-hover:text-accent"
    style="letter-spacing: -0.02em"
  >
    {article.title}
  </h4>
  <p class="text-fg-muted text-sm leading-relaxed">{article.excerpt}</p>
</a>
