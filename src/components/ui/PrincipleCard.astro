---
import type { Principle } from '../../data/content'

interface Props {
  principle: Principle
}

const { principle } = Astro.props
---

<div class="card h-full p-6 md:p-8">
  <div class="t-meta text-accent mb-4">{principle.n}</div>
  <h3 class="t-h3 mb-2">{principle.title}</h3>
  <p class="t-body m-0">{principle.body}</p>
</div>
