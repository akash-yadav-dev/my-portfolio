---
import '../styles/globals.css'
// Self-hosted fonts (replaces next/font/google — same faces)
import '@fontsource/fraunces/300.css'
import '@fontsource/fraunces/400.css'
import '@fontsource/fraunces/500.css'
import '@fontsource/fraunces/600.css'
import '@fontsource/fraunces/400-italic.css'
import '@fontsource/plus-jakarta-sans/400.css'
import '@fontsource/plus-jakarta-sans/500.css'
import '@fontsource/plus-jakarta-sans/600.css'
import '@fontsource/plus-jakarta-sans/700.css'
import '@fontsource/jetbrains-mono/400.css'
import '@fontsource/jetbrains-mono/500.css'
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import { content } from '../data/content'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const { title, description, noindex } = Astro.props

const pageTitle = title
  ? `${title} — ${content.profile.name}`
  : `${content.profile.name} — ${content.profile.role}`

const pageDescription =
  description ??
  'Akash Yadav is a freelance full stack developer who builds websites and web apps, including booking and ordering platforms. 4 years of experience, AI-powered features and seven live products. Based in Bangalore, available for freelance and project work.'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={content.profile.name} />
    <script>
      // Progressive enhancement: only enable scroll-reveal hiding when JS is active.
      document.documentElement.classList.add('js')
    </script>
  </head>
  <body>
    <Header />
    <div class="max-w-site mx-auto px-6 md:px-10 lg:px-14">
      <main><slot /></main>
      <Footer />
    </div>
    <script>
      import '../scripts/reveal.ts'
    </script>
  </body>
</html>
